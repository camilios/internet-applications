{
  "uid": "req6-orders",
  "title": "Orders · Monitoring & Observability",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests by API replica",
      "description": "Completed HTTP responses since the collector started. The gateway label means no API address was available.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "req6-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (replica) (order_http_requests_total)",
          "legendFormat": "{{replica}}",
          "datasource": {
            "type": "prometheus",
            "uid": "req6-prom"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Response time · p95",
      "description": "95th percentile client-facing duration at Nginx, including any upstream retry.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "req6-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, replica) (rate(order_http_duration_seconds_bucket[1m])))",
          "legendFormat": "{{replica}}",
          "datasource": {
            "type": "prometheus",
            "uid": "req6-prom"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP errors per minute",
      "description": "4xx and 5xx responses returned to clients, including gateway failures.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "req6-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(order_http_requests_total{status=~\"[45]..\"}[1m])) or vector(0)",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "req6-prom"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Email queue depth",
      "description": "Ready plus unacknowledged messages. The alert below uses ready messages waiting to be consumed.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "req6-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_queue_messages{queue=\"orders.email\"}",
          "legendFormat": "{{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "req6-prom"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Email messages waiting",
      "description": "The queue-high alert threshold is five ready messages for 10 seconds.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "req6-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_queue_messages_ready{queue=\"orders.email\"}",
          "legendFormat": "ready",
          "datasource": {
            "type": "prometheus",
            "uid": "req6-prom"
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Requests per second",
      "description": "Load distributed across final upstream addresses.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "req6-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (replica) (rate(order_http_requests_total[1m]))",
          "legendFormat": "{{replica}}",
          "datasource": {
            "type": "prometheus",
            "uid": "req6-prom"
          }
        }
      ]
    }
  ]
}

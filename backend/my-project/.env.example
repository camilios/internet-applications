APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
JWT_SECRET=
JWT_TTL=60
INVENTORY_GRPC_HOST=inventory-service:50051
INVENTORY_GRPC_TIMEOUT=5
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=ecommerce
DB_USERNAME=laravel
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Requested local mock mode: records delivery_mode=mock and sends no external email.
# For real delivery set MAIL_MAILER=smtp, ORDER_EMAIL_ALLOW_MOCK=false and configure your provider.
MAIL_MAILER=log
ORDER_EMAIL_ALLOW_MOCK=true
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma-separated IPs of real reverse proxies only; empty for direct HTTP.
TRUSTED_PROXIES=

# Enable only after provisioning and validating the MySQL replica.
DB_REPLICA_ENABLED=false
DB_READ_HOST=127.0.0.1

# Independent Req4 processes: outbox:publish, orders:email-worker, queue:work database --queue=broadcasts, reverb:start.
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=orders
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=ecommerce
RABBITMQ_CONNECTION_TIMEOUT=3
RABBITMQ_READ_WRITE_TIMEOUT=60
RABBITMQ_HEARTBEAT=20
RABBITMQ_CONFIRM_TIMEOUT=5
RABBITMQ_MAX_ATTEMPTS=5
RABBITMQ_RETRY_DELAYS=5,30,120,300
RABBITMQ_RECONNECT_DELAY=5
OUTBOX_POLL_INTERVAL=1
OUTBOX_MAX_BACKOFF=300
MAIL_TIMEOUT=20

# Set BROADCAST_CONNECTION=reverb when running Reverb; keep log for a REST-only local setup.
REVERB_APP_ID=ecommerce
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Origin hostnames only, without scheme or port.
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

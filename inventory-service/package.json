{
  "name": "inventory-service",
  "version": "1.0.0",
  "description": "gRPC Inventory Microservice",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "jest --detectOpenHandles --forceExit",
    "test:race": "jest --detectOpenHandles --forceExit src/services/inventory-service.test.ts --testNamePattern=concurrent",
    "migrate": "ts-node src/database/migrate.ts",
    "seed": "ts-node src/database/seed.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.9.0",
    "@grpc/proto-loader": "^0.7.0",
    "dotenv": "^16.3.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  }
}

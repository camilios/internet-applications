# Docker Compose Environment Variables
# Copy this file to .env and change the values

# Laravel App Key (generate with: php artisan key:generate --show)
APP_KEY=

# JWT Secret (generate with: php artisan jwt:secret --show)
JWT_SECRET=change_me_jwt_secret

# Database passwords are stored separately for each database in:
# ./secrets/mysql_root_password.txt
# ./secrets/mysql_password.txt
# ./secrets/inventory_mysql_root_password.txt
# ./secrets/inventory_mysql_password.txt
# ./secrets/mysql_integration_root_password.txt
# ./secrets/mysql_integration_password.txt
# ./secrets/inventory_mysql_integration_root_password.txt
# ./secrets/inventory_mysql_integration_password.txt
# Create these local files with unique passwords; do not commit them.

# Use 5174 when a local Vite process already owns 5173.
FRONTEND_PORT=5173

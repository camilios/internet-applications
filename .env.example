# Docker Compose Environment Variables
# Copy this file to .env and change the values

# Laravel App Key (generate with: php artisan key:generate --show)
APP_KEY=

# JWT Secret (generate with: php artisan jwt:secret --show)
JWT_SECRET=change_me_jwt_secret

# Database passwords are stored separately for each database in:
# ./secrets/mysql_root_password.txt
# ./secrets/mysql_password.txt
# ./secrets/inventory_mysql_root_password.txt
# ./secrets/inventory_mysql_password.txt
# ./secrets/mysql_integration_root_password.txt
# ./secrets/mysql_integration_password.txt
# ./secrets/inventory_mysql_integration_root_password.txt
# ./secrets/inventory_mysql_integration_password.txt
# Create these local files with unique passwords; do not commit them.

# Use 5174 when a local Vite process already owns 5173.
FRONTEND_PORT=5173

# Req 4: generate distinct random local values for these two secrets.
RABBITMQ_PASSWORD=
REVERB_APP_SECRET=
RABBITMQ_USER=orders
RABBITMQ_VHOST=ecommerce
RABBITMQ_CONNECTION_TIMEOUT=3
RABBITMQ_READ_WRITE_TIMEOUT=60
RABBITMQ_HEARTBEAT=20
RABBITMQ_CONFIRM_TIMEOUT=5
RABBITMQ_RECONNECT_DELAY=5
RABBITMQ_MAX_ATTEMPTS=5
# Retry delays in seconds, bounded by backend configuration.
RABBITMQ_RETRY_DELAYS=5,30,120,300
OUTBOX_POLL_INTERVAL=1
OUTBOX_MAX_BACKOFF=300

# Public browser key must match Laravel/Reverb; never put the secret in VITE_*.
REVERB_APP_ID=ecommerce
REVERB_APP_KEY=ecommerce-local
REVERB_PORT=8080
REVERB_BIND_ADDRESS=127.0.0.1
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
VITE_REVERB_HOST=localhost
VITE_REVERB_SCHEME=http
VITE_API_URL=http://localhost:8000/api
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Explicit local mock mode (requested for now); no external email is sent.
# Disable mock mode and configure SMTP before claiming external delivery.
MAIL_MAILER=log
ORDER_EMAIL_ALLOW_MOCK=true
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=E-Commerce
MAIL_TIMEOUT=20
